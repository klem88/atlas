{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atlas-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "atlas-prod-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--base",
        "/atlas/",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "atlas-dev-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}